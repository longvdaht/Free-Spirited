<script id="fs-insiders-cro-script-2026-08-29">
  (() => {
    if (window.FSInsidersCRO) return;

    const state = window.FSInsidersCRO = {
      sizeByPath: Object.create(null),
      queued: false
    };

    const money = (cents) => {
      const amount = Number(cents || 0) / 100;
      const currency = (window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD';
      try {
        return new Intl.NumberFormat(undefined, {
          style: 'currency',
          currency,
          minimumFractionDigits: amount % 1 ? 2 : 0,
          maximumFractionDigits: 2
        }).format(amount);
      } catch (error) {
        return '$' + amount.toFixed(2);
      }
    };

    const suppressPromotion = () => {
      document.documentElement.classList.add('fs-high-intent');
      try { sessionStorage.setItem('fsHighIntent', '1'); } catch (error) {}
    };

    try {
      if (sessionStorage.getItem('fsHighIntent') === '1') suppressPromotion();
    } catch (error) {}

    const openSizeHelp = () => {
      const direct = Array.from(document.querySelectorAll('button, a, [role="button"]')).find((element) => {
        if (element.classList.contains('fs-inline-size-chart') || element.classList.contains('fs-sticky-size-guide')) return false;
        return /what.?s my size|find my size|size calculator/i.test((element.textContent || '').trim());
      });
      if (direct) {
        direct.click();
        return;
      }

      const accordion = Array.from(document.querySelectorAll('button, summary, [role="button"]')).find((element) =>
        /sizing help|find your perfect fit/i.test((element.textContent || '').trim())
      );
      if (accordion) {
        accordion.click();
        accordion.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    };

    const setSizeGate = (chosen) => {
      document.body.classList.toggle('fs-size-selected', Boolean(chosen));
      document.querySelectorAll('.main-product-content [data-add-to-cart], .sticky-cart [data-add-to-cart]').forEach((button) => {
        if (!chosen) {
          if (!button.classList.contains('fs-size-gated')) {
            button.dataset.fsDisabledBeforeSize = button.disabled ? 'true' : 'false';
          }
          button.disabled = true;
          button.setAttribute('aria-disabled', 'true');
          button.classList.add('fs-size-gated');
        } else if (button.classList.contains('fs-size-gated')) {
          button.classList.remove('fs-size-gated');
          if (button.dataset.fsDisabledBeforeSize !== 'true') {
            button.disabled = false;
            button.removeAttribute('aria-disabled');
          }
          delete button.dataset.fsDisabledBeforeSize;
        }
      });
    };

    const chooseSize = (label) => {
      if (!label) return;
      state.sizeByPath[window.location.pathname] = label;
      suppressPromotion();
      setSizeGate(label);
      document.querySelectorAll('.fs-size-choice').forEach((button) => {
        const selected = button.dataset.fsSize === label;
        button.classList.toggle('is-selected', selected);
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
    };

    const enhanceSizePicker = () => {
      const productContent = document.querySelector('.main-product-content');
      if (!productContent) return;

      const pickers = Array.from(productContent.querySelectorAll('.product-variants-options'));
      const picker = pickers.find((candidate) => {
        const heading = candidate.querySelector('h1, h2, h3, h4, h5, h6, label, legend');
        return heading && /^size\b/i.test((heading.textContent || '').trim());
      }) || (pickers.length === 1 ? pickers[0] : null);
      if (!picker) return;

      const nativeSelect = picker.querySelector('.custom-select');
      const options = Array.from(picker.querySelectorAll('.custom-select-list .option'));
      if (!nativeSelect || options.length < 2) return;

      let panel = picker.querySelector('.fs-size-choice-panel');
      if (!panel) {
        panel = document.createElement('div');
        panel.className = 'fs-size-choice-panel';
        panel.setAttribute('role', 'group');
        panel.setAttribute('aria-label', 'Choose a size');

        options.forEach((option) => {
          const label = (option.textContent || '').trim();
          if (!label) return;
          const button = document.createElement('button');
          const unavailable = option.classList.contains('disabled') || option.getAttribute('aria-disabled') === 'true';
          button.type = 'button';
          button.className = 'fs-size-choice';
          button.dataset.fsSize = label;
          button.textContent = label;
          button.disabled = unavailable;
          button.setAttribute('aria-pressed', 'false');
          button.addEventListener('click', () => {
            if (unavailable) return;
            chooseSize(label);
            option.click();
          });
          panel.appendChild(button);
        });

        nativeSelect.insertAdjacentElement('beforebegin', panel);

        const fitLine = document.createElement('div');
        fitLine.className = 'fs-size-fit-line';
        fitLine.innerHTML = '<span><strong>True-to-size fit</strong> · choose your usual size</span>';
        const sizeHelp = document.createElement('button');
        sizeHelp.type = 'button';
        sizeHelp.className = 'fs-inline-size-chart';
        sizeHelp.textContent = 'Size chart';
        sizeHelp.addEventListener('click', openSizeHelp);
        fitLine.appendChild(sizeHelp);
        panel.insertAdjacentElement('afterend', fitLine);
        picker.classList.add('fs-has-size-buttons');
      }

      const chosen = state.sizeByPath[window.location.pathname] || '';
      panel.querySelectorAll('.fs-size-choice').forEach((button) => {
        const selected = chosen && button.dataset.fsSize === chosen;
        button.classList.toggle('is-selected', Boolean(selected));
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      setSizeGate(chosen);
    };

    const enhanceCartModes = () => {
      const drawer = document.querySelector('#cart-side-drawer');
      if (!drawer) return;
      const insider = drawer.querySelector('[data-fs-mode="insider"]');
      const full = drawer.querySelector('[data-fs-mode="full_price"]');
      if (!insider || !full) return;

      const subtotal = drawer.querySelector('[data-cart-subtotal]');
      const total = drawer.querySelector('[data-cart-total]');
      const insiderCents = subtotal && subtotal.dataset.insiderSubtotal || total && total.dataset.insiderTotal || 0;
      const fullCents = subtotal && subtotal.dataset.fullSubtotal || total && total.dataset.fullTotal || 0;

      const activeInsider = insider.classList.contains('active');
      insider.setAttribute('aria-pressed', activeInsider ? 'true' : 'false');
      full.setAttribute('aria-pressed', activeInsider ? 'false' : 'true');
      const insiderMarkup =
        '<span class="fs-mode-title"><span class="fs-mode-check" aria-hidden="true">✓</span> INSIDER PRICING</span>' +
        '<span class="fs-mode-price">' + money(insiderCents) + ' today</span>' +
        '<span class="fs-mode-detail">21 days free, then $24.95/month</span>' +
        '<span class="fs-mode-detail">Includes a $30 monthly credit and member perks</span>';
      const fullMarkup =
        '<span class="fs-mode-title"><span class="fs-mode-check" aria-hidden="true">✓</span> FULL PRICE</span>' +
        '<span class="fs-mode-price">' + money(fullCents) + ' one-time</span>' +
        '<span class="fs-mode-detail">No Club membership</span>';
      if (insider.innerHTML !== insiderMarkup) insider.innerHTML = insiderMarkup;
      if (full.innerHTML !== fullMarkup) full.innerHTML = fullMarkup;

      const discount = drawer.querySelector('[data-fs-discount]');
      if (discount && !discount.closest('.fs-discount-details')) {
        const details = document.createElement('details');
        details.className = 'fs-discount-details';
        const summary = document.createElement('summary');
        summary.className = 'fs-discount-summary';
        summary.textContent = 'Have a discount code?';
        discount.insertAdjacentElement('beforebegin', details);
        details.appendChild(summary);
        details.appendChild(discount);
      }
    };

    const hydrate = () => {
      state.queued = false;
      enhanceSizePicker();
      enhanceCartModes();
    };

    const queueHydrate = () => {
      if (state.queued) return;
      state.queued = true;
      window.requestAnimationFrame(hydrate);
    };

    document.addEventListener('click', (event) => {
      const nativeSize = event.target.closest('.sticky-cart .custom-select-list .option');
      if (nativeSize) chooseSize((nativeSize.textContent || '').trim());

      if (event.target.closest('[data-add-to-cart], [data-fs-cc-checkout], [data-fs-native-checkout], [href="#cart-side-drawer"], [data-cart-drawer-open]')) {
        suppressPromotion();
      }

      if (event.target.closest('[data-fs-mode]')) window.setTimeout(queueHydrate, 0);
    }, true);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', hydrate, { once: true });
    } else {
      hydrate();
    }
    document.addEventListener('shopify:section:load', queueHydrate);
    new MutationObserver(queueHydrate).observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>

