<!doctype html>
  <html class="no-js" lang="{{ request.locale.iso_code }}">
    <head>
     {%
    include 'cc-cart.js' with      
      checkout_url: 'https://checkout.shopfreespirited.com/checkout'
  %}
      <meta charset="utf-8">
      <meta http-equiv="X-UA-Compatible" content="IE=edge">
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <meta name="theme-color" content="#F5F5F5">
      {% render 'meta-tags' %}
      {% if request.page_type == 'collection' and collection %}
      <link rel="canonical" href="{{ collection.url | prepend: request.origin }}">
      {% else %}
      <link rel="canonical" href="{{ canonical_url }}">
      {% endif %}
      <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
      {%- if settings.favicon != blank -%}
        <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      {%- endif -%}
  
      {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
        <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {%- endunless -%}
  
      <title>
        {{ page_title }}
      </title>
  
      {% if page_description %}
        <meta name="description" content="{{ page_description | escape }}">
      {% endif %}
      {%- render 'header-scripts.zipifypages', renderctx: 'thm', apprxhbl: zp_apprxhbl -%}{{ content_for_header }}

      {%- render 'global-style-variables' -%}
      {%- render 'global-variables' -%}

<script async src="https://session.frauddeflect.net/static/v4.10195.js" charset="utf-8"></script>

      <style id="fs-cro-release-2026-08-27">
        .jdgm-popup-widget__cards-container {
          display: none !important;
        }
        .product-full-price,
        .product-price-group .product-full-price,
        .fs-card-price-line .product-full-price,
        .sticky-cart .product-full-price {
          text-decoration: none !important;
        }

        /* Cart drawer: keep the decision simple and checkout visible. */
        #cart-side-drawer .side-drawer-panel,
        #cart-side-drawer .side-drawer-inner,
        #cart-side-drawer .cart-drawer-content {
          height: 100%;
        }
        #cart-side-drawer .cart-drawer-content {
          display: flex;
          min-height: 0;
          flex-direction: column;
        }
        #cart-side-drawer [data-notification] { order: 0; }
        #cart-side-drawer [data-cart-drawer-header] { order: 1; }
        #cart-side-drawer .fs-mode-toggle { order: 2; }
        #cart-side-drawer .fs-mode-disclosure { order: 3; }
        #cart-side-drawer [data-cart-content] {
          order: 4;
          min-height: 0;
          overflow-y: auto;
          overscroll-behavior: contain;
        }
        #cart-side-drawer [data-cart-drawer-footer] {
          order: 5;
          position: sticky;
          bottom: 0;
          z-index: 6;
          flex: 0 0 auto;
          background: var(--body-background, #fff);
          border-top: 1px solid rgba(0, 0, 0, .1);
          box-shadow: 0 -10px 24px rgba(0, 0, 0, .08);
        }
        #cart-side-drawer .fs-mode-toggle {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 8px;
          margin: 10px 18px 0;
        }
        #cart-side-drawer .fs-mode-toggle .button {
          min-height: 42px;
          padding: 9px 10px;
          font-size: 12px;
          font-weight: 800;
          letter-spacing: .02em;
        }
        #cart-side-drawer .fs-mode-disclosure {
          margin: 8px 18px 12px;
          padding: 8px 10px;
          font-size: 11.5px;
          line-height: 1.4;
        }
        #cart-side-drawer .cart-recomdations {
          margin-top: 12px;
        }
        #cart-side-drawer .cart-recomdations-item-inner {
          display: grid;
          grid-template-columns: 72px minmax(0, 1fr) auto;
          gap: 10px;
          align-items: center;
          padding: 9px;
          border: 1px solid rgba(0, 0, 0, .1);
          border-radius: 10px;
        }
        #cart-side-drawer .cart-recomdations-item-image {
          width: 72px;
        }
        #cart-side-drawer .cart-recomdations-item-info .product-title {
          display: -webkit-box;
          overflow: hidden;
          -webkit-box-orient: vertical;
          -webkit-line-clamp: 2;
          line-height: 1.25;
        }
        #cart-side-drawer .fs-insider-savings-row {
          color: #016f94;
          font-weight: 800;
        }
        #cart-side-drawer .fs-cart-subtotal-row {
          display: none;
        }
        #cart-side-drawer [data-fs-mode-buttons] {
          display: grid;
          grid-template-columns: 1fr;
          gap: 5px;
        }
        #cart-side-drawer [data-fs-mode-buttons] > .button:first-child {
          min-height: 52px;
          font-size: 16px;
          font-weight: 850;
        }
        #cart-side-drawer [data-fs-mode-buttons] > .outline-button {
          min-height: auto;
          padding: 5px 8px;
          border: 0;
          font-size: 12px;
          text-decoration: underline;
          text-underline-offset: 3px;
        }
        #cart-side-drawer [data-fs-mode-buttons] > .outline-button .button-arrow {
          display: none;
        }
        @media (max-width: 767px) {
          .jdgm-revs-tab-btn,
          .privy-tab-container,
          .pushowl-simple-toast {
            display: none !important;
          }
          .main-product-image-slider [id^="productMedia"] .media-box {
            --image-ratio: 75% !important;
          }
          .main-product-image-slider [id^="productMedia"] .media-box > img {
            object-fit: contain !important;
          }
          .main-product-content {
            padding-top: 12px !important;
          }

          /* A true mobile purchase bar: price + selected size + clear action. */
          .sticky-cart.show {
            display: grid !important;
            grid-template-columns: minmax(88px, .75fr) minmax(190px, 1.55fr);
            gap: 10px;
            align-items: center;
            padding: 9px 10px calc(9px + env(safe-area-inset-bottom));
            background: #fff;
            border-top: 1px solid rgba(0, 0, 0, .12);
            box-shadow: 0 -8px 24px rgba(0, 0, 0, .14);
          }
          .sticky-cart .sticky-cart-button,
          .sticky-cart .sticky-cart-media,
          .sticky-cart .sticky-cart-info .product-title,
          .sticky-cart .product-discount-price,
          .sticky-cart .product-full-price {
            display: none !important;
          }
          .sticky-cart .sticky-cart-detail {
            min-width: 0;
            margin: 0;
          }
          .sticky-cart .sticky-cart-info {
            min-width: 0;
          }
          .sticky-cart .product-price-group {
            display: block;
          }
          .sticky-cart .product-actual-price {
            display: block;
            color: #016f94;
            font-size: 17px;
            font-weight: 850;
            line-height: 1.1;
          }
          .sticky-cart .product-actual-price::before {
            content: "Insider Price";
            display: block;
            margin-bottom: 3px;
            color: #333;
            font-size: 9px;
            font-weight: 800;
            line-height: 1;
            letter-spacing: .055em;
            text-transform: uppercase;
          }
          .sticky-cart .sticky-cart-options {
            display: grid !important;
            grid-template-columns: 66px minmax(118px, 1fr);
            gap: 7px;
            align-items: stretch;
            min-width: 0;
          }
          .sticky-cart .product-variants-options,
          .sticky-cart .product-checkout-buttons {
            min-width: 0;
          }
          .sticky-cart .product-variants-title {
            display: none;
          }
          .sticky-cart .custom-select,
          .sticky-cart .custom-select-button {
            height: 100%;
            min-height: 48px;
          }
          .sticky-cart .custom-select-button {
            display: flex;
            padding: 7px 8px;
            align-items: center;
            justify-content: space-between;
            border-color: rgba(0, 0, 0, .25);
            border-radius: 8px;
          }
          .sticky-cart .custom-select-text::before {
            content: "Size ";
            font-size: 10px;
            font-weight: 600;
          }
          .sticky-cart [data-sticky-atc-wrapper] {
            min-height: 48px;
            padding: 9px 11px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 850;
            white-space: nowrap;
          }
          .sticky-cart [data-sticky-atc-wrapper] .button-arrow {
            display: none;
          }

          #cart-side-drawer .cart-drawer-content-footer-inner {
            padding-top: 10px;
            padding-bottom: calc(10px + env(safe-area-inset-bottom));
          }
          #cart-side-drawer .cart-summary-price {
            margin: 7px 0 9px;
          }
          #cart-side-drawer .cart-summary-price-item {
            margin-bottom: 4px;
          }
          #cart-side-drawer .cart-summary-tax-info {
            margin-top: 4px;
            font-size: 10px;
            text-align: center;
          }
        }
      </style>

    </head>
    <body class="{{ settings.other_layout }} button-hover-{{ settings.button_hover_effect }}{% if settings.enable_animation %} animation-on{% endif %}">
      {% if template contains 'cart' %}
        <h1 class="visually-hidden" style="display: none">Cart</h1>
      {% endif %}
      <a class="unstyled-link skip-to-content-link button focus-inside{% if settings.enable_button_shadow %} button-shadow{% endif %}" href="#MainContent">
        {{ 'accessibility.skip_to_text' | t }}
      </a>
      {%- render 'preloader' -%}
      <div class="body-main">
        {% sections 'header-group' %}
        <main id="MainContent" class="main-content focus-none" role="main" tabindex="-1" >
          {{ content_for_layout }} 
        </main>
        <div class="custom-footer-group">  
        {% sections 'footer-group' %}
        </div>
        {% section 'mobile-dock' %}
      </div> 
        {% render 'newsletter-popup' %}
        {% render 'cookies-popup' %}
        {% render 'age-verification' %}
        {% render 'search-drawer' %}
        {% render 'cart-drawer' %}
        {% render 'quick-view' %}
        {% render 'scroll-top' %}

        {% if settings.enable_shipping and settings.shipping_rate != blank %}
          <div id="mini-cart-shipping"  data-minicart-shipping {% if settings.enable_shipping and settings.shipping_rate != blank %}  data-shipping-rate="{{ settings.shipping_rate | times: 100 }}" data-shippin-text="{{ settings.shipping_text }}"{% endif %}>
            <select id="shipping-countries" class="hidden" disabled>
              {{ country_option_tags }}
            </select>
          </div>
        {% endif %}
        {% if settings.enable_animation %}
          <script>
            document.addEventListener("DOMContentLoaded",function(){
              AOS.init({
                startEvent: 'DOMContentLoaded',
                offset: 160,
                once: true,
              });
              setTimeout(function () {
                if (AOS) {
                  AOS.refresh();
                }
              }, 1000);
            });
          </script>
        {% endif %}
      <script>
        document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
        if (Shopify.designMode) {
          document.documentElement.classList.add('shopify-design-mode');
        }
    
      </script>
     
