<script async src="https://session.frauddeflect.net/static/v4.10195.js" charset="utf-8"></script>

      <style id="fs-cro-release-2026-08-27">
        .jdgm-popup-widget__cards-container {
          display: none !important;
        }
        .product-full-price,
        .product-price-group .product-full-price,
        .fs-card-price-line .product-full-price,
        .sticky-cart .product-full-price {
          text-decoration: none !important;
        }

        /* Cart drawer: keep the decision simple and checkout visible. */
        #cart-side-drawer .side-drawer-panel,
        #cart-side-drawer .side-drawer-inner,
        #cart-side-drawer .cart-drawer-content {
          height: 100%;
        }
        #cart-side-drawer .cart-drawer-content {
          display: flex;
          min-height: 0;
          flex-direction: column;
        }
        #cart-side-drawer [data-notification] { order: 0; }
        #cart-side-drawer [data-cart-drawer-header] { order: 1; }
        #cart-side-drawer .fs-mode-toggle { order: 2; }
        #cart-side-drawer .fs-mode-disclosure { order: 3; }
        #cart-side-drawer [data-cart-content] {
          order: 4;
          min-height: 0;
          overflow-y: auto;
          overscroll-behavior: contain;
        }
        #cart-side-drawer [data-cart-drawer-footer] {
          order: 5;
          position: sticky;
          bottom: 0;
          z-index: 6;
          flex: 0 0 auto;
          background: var(--body-background, #fff);
          border-top: 1px solid rgba(0, 0, 0, .1);
          box-shadow: 0 -10px 24px rgba(0, 0, 0, .08);
        }
        #cart-side-drawer .fs-mode-toggle {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 8px;
          margin: 10px 18px 0;
        }
        #cart-side-drawer .fs-mode-toggle .button {
          min-height: 42px;
          padding: 9px 10px;
          font-size: 12px;
          font-weight: 800;
          letter-spacing: .02em;
        }
        #cart-side-drawer .fs-mode-disclosure {
          margin: 8px 18px 12px;
          padding: 8px 10px;
          font-size: 11.5px;
          line-height: 1.4;
        }
        #cart-side-drawer .cart-recomdations {
          margin-top: 12px;
        }
        #cart-side-drawer .cart-recomdations-item-inner {
          display: grid;
          grid-template-columns: 72px minmax(0, 1fr) auto;
          gap: 10px;
          align-items: center;
          padding: 9px;
          border: 1px solid rgba(0, 0, 0, .1);
          border-radius: 10px;
        }
        #cart-side-drawer .cart-recomdations-item-image {
          width: 72px;
        }
        #cart-side-drawer .cart-recomdations-item-info .product-title {
