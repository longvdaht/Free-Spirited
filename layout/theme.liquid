    <body class="{{ settings.other_layout }} button-hover-{{ settings.button_hover_effect }}{% if settings.enable_animation %} animation-on{% endif %}">
      <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KVZQTCFR"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
      {% if template contains 'cart' %}
        <h1 class="visually-hidden" style="display: none">Cart</h1>
      {% endif %}
      <a class="unstyled-link skip-to-content-link button focus-inside{% if settings.enable_button_shadow %} button-shadow{% endif %}" href="#MainContent">
        {{ 'accessibility.skip_to_text' | t }}
      </a>
      {%- render 'preloader' -%}
      <div class="body-main">
        {% sections 'header-group' %}
        <main id="MainContent" class="main-content focus-none" role="main" tabindex="-1" >
          {{ content_for_layout }} 
        </main>
        {% if request.page_type == 'product' and template.suffix != 'insider-membership' %}
          <template id="fs-cold-reassurance-template">
            <aside class="fs-cold-reassurance" aria-label="Order reassurance">
              <div class="fs-cold-reassurance__grid">
                <div class="fs-cold-reassurance__item">
                  <span class="fs-cold-reassurance__icon" aria-hidden="true">→</span>
                  <strong>Ships in 1 business day</strong>
                  <small>From Sunrise, Florida</small>
                </div>
                <div class="fs-cold-reassurance__item">
                  <span class="fs-cold-reassurance__icon" aria-hidden="true">30</span>
                  <strong>30-day returns</strong>
                  <small>No questions asked</small>
                </div>
                <div class="fs-cold-reassurance__item">
                  <span class="fs-cold-reassurance__icon" aria-hidden="true">✦</span>
                  <strong>Ships from Florida</strong>
                  <small>Each piece is one of a kind</small>
                </div>
              </div>
              <p class="fs-cold-reassurance__footer">Secure checkout · Tracking on every order · Real 24/7 human support</p>
            </aside>
          </template>

          <template id="fs-pdp-ugc-template">
            <section class="fs-pdp-ugc" aria-labelledby="fs-pdp-ugc-title">
              <div class="fs-pdp-ugc__inner">
                <p class="fs-pdp-ugc__eyebrow">Real Free Spirited customers</p>
                <h2 class="fs-pdp-ugc__title" id="fs-pdp-ugc-title">Worn by real people. Made to be noticed.</h2>
                <p class="fs-pdp-ugc__rating" data-fs-pdp-rating></p>
                <p class="fs-pdp-ugc__copy">See how Free Spirited color looks in everyday life—bright, comfortable, and unmistakably personal.</p>
                <div class="fs-pdp-ugc__track" aria-label="Real customer photos">
                  <div class="fs-pdp-ugc__card">
                    <img src="https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-1.jpg?v=1787857564&amp;width=700" width="700" height="875" loading="lazy" decoding="async" alt="Real Free Spirited customers wearing colorful hand-dyed shirts">
                  </div>
                  <div class="fs-pdp-ugc__card">
                    <img src="https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-01.jpg?v=1787858490&amp;width=700" width="700" height="875" loading="lazy" decoding="async" alt="Real Free Spirited customers wearing tie-dye in everyday life">
                  </div>
                  <div class="fs-pdp-ugc__card">
                    <img src="https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-07.jpg?v=1787858494&amp;width=700" width="700" height="875" loading="lazy" decoding="async" alt="Free Spirited customers enjoying colorful hand-dyed clothing together">
                  </div>
                  <div class="fs-pdp-ugc__card">
                    <img src="https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-2.png?v=1787857568&amp;width=700" width="700" height="875" loading="lazy" decoding="async" alt="Customers of different ages wearing Free Spirited tie-dye shirts">
                  </div>
                </div>
                <p class="fs-pdp-ugc__note">Customer photos, shared with permission. Swipe to see more.</p>
                <button class="fs-pdp-ugc__cta" type="button" data-fs-pdp-choose-size>Choose Your Size</button>
              </div>
            </section>
          </template>

          <script>
            (() => {
              let fsProductEnhanceQueued = false;

              const fsOpenSizeHelp = () => {
                const directSizeHelp = Array.from(document.querySelectorAll('button, a, [role="button"]')).find((element) => {
                  if (element.classList.contains('fs-sticky-size-guide')) return false;
                  return /what.?s my size|find my size|size calculator/i.test((element.textContent || '').trim());
                });

                if (directSizeHelp) {
                  directSizeHelp.click();
                  return;
                }

                const sizingAccordion = Array.from(document.querySelectorAll('button, summary, [role="button"]')).find((element) =>
                  /sizing help|find your perfect fit/i.test((element.textContent || '').trim())
                );

                if (sizingAccordion) {
                  sizingAccordion.click();
                  sizingAccordion.scrollIntoView({ behavior: 'smooth', block: 'center' });
                  return;
                }

                const sizePicker = document.querySelector('.main-product-content .product-variants-options');
                if (sizePicker) sizePicker.scrollIntoView({ behavior: 'smooth', block: 'center' });
              };

              const fsEnhanceProduct = () => {
                fsProductEnhanceQueued = false;
                const productContent = document.querySelector('.main-product-content');
                if (!productContent) return;

                const mainAtc = productContent.querySelector('[data-add-to-cart]:not([data-sticky-atc-wrapper])');
                const checkoutButtons = mainAtc && mainAtc.closest('.product-checkout-buttons');
                const reassuranceTemplate = document.getElementById('fs-cold-reassurance-template');
                if (checkoutButtons && reassuranceTemplate && !productContent.querySelector('.fs-cold-reassurance')) {
                  checkoutButtons.insertAdjacentElement('afterend', reassuranceTemplate.content.firstElementChild.cloneNode(true));
                }

                productContent.querySelectorAll('p.product-description.detail-text').forEach((paragraph) => {
                  if (/easy returns and exchanges.*24\/7 human support/i.test(paragraph.textContent || '')) paragraph.hidden = true;
                });

                const mainSection = productContent.closest('.shopify-section');
                const ugcTemplate = document.getElementById('fs-pdp-ugc-template');
                if (mainSection && ugcTemplate && !document.querySelector('.fs-pdp-ugc')) {
                  mainSection.insertAdjacentElement('afterend', ugcTemplate.content.firstElementChild.cloneNode(true));
                }

                const ratingBadge = productContent.querySelector('.jdgm-prev-badge');
                const ratingOutput = document.querySelector('[data-fs-pdp-rating]');
                if (ratingBadge && ratingOutput && !ratingOutput.dataset.hydrated) {
                  const average = Number(ratingBadge.dataset.averageRating || 0);
                  const reviews = Number(ratingBadge.dataset.numberOfReviews || 0);
                  if (average > 0 && reviews > 0) {
                    ratingOutput.textContent = '★★★★★ ' + average.toFixed(1) + ' from ' + reviews.toLocaleString() + ' verified reviews';
                    ratingOutput.style.display = 'block';
                    ratingOutput.dataset.hydrated = 'true';
                  }
                }

                document.querySelectorAll('.sticky-cart .custom-select-content').forEach((menu) => {
                  if (menu.querySelector('.fs-sticky-size-guide')) return;
                  const guideButton = document.createElement('button');
                  guideButton.type = 'button';
                  guideButton.className = 'fs-sticky-size-guide';
                  guideButton.textContent = 'What’s my size?';
                  guideButton.addEventListener('click', (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    menu.style.display = 'none';
                    const stickyButton = menu.parentElement && menu.parentElement.querySelector('.custom-select-button');
                    if (stickyButton) stickyButton.setAttribute('aria-expanded', 'false');
                    fsOpenSizeHelp();
                  });
                  menu.prepend(guideButton);
                });

                document.querySelectorAll('.sticky-cart .custom-select-button').forEach((button) => {
                  if (!button.hasAttribute('role')) button.setAttribute('role', 'button');
                  if (!button.hasAttribute('tabindex')) button.setAttribute('tabindex', '0');
                  if (!button.hasAttribute('aria-label')) button.setAttribute('aria-label', 'Choose a size');
                  if (!button.hasAttribute('aria-expanded')) button.setAttribute('aria-expanded', 'false');
                  if (!button.dataset.fsStickyBound) {
                    button.dataset.fsStickyBound = 'true';
                    button.addEventListener('click', (event) => {
                      event.preventDefault();
                      event.stopImmediatePropagation();
                      const menu = button.parentElement && button.parentElement.querySelector('.custom-select-content');
                      if (!menu) return;
                      const shouldOpen = button.getAttribute('aria-expanded') !== 'true';
                      document.querySelectorAll('.sticky-cart .custom-select-content').forEach((otherMenu) => {
                        if (otherMenu !== menu) otherMenu.style.display = 'none';
                      });
                      menu.style.display = shouldOpen ? 'block' : 'none';
                      button.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
                    }, true);
                    button.addEventListener('keydown', (event) => {
                      if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        button.click();
                      }
                    });
                  }
                });

                if (!document.documentElement.dataset.fsStickyOutsideBound) {
                  document.documentElement.dataset.fsStickyOutsideBound = 'true';
                  document.addEventListener('click', (event) => {
                    if (event.target.closest('.sticky-cart .custom-select')) return;
                    document.querySelectorAll('.sticky-cart .custom-select-content').forEach((menu) => {
                      menu.style.display = 'none';
                    });
                    document.querySelectorAll('.sticky-cart .custom-select-button').forEach((button) => {
                      button.setAttribute('aria-expanded', 'false');
                    });
                  });
                }

                const chooseSize = document.querySelector('[data-fs-pdp-choose-size]');
                if (chooseSize && !chooseSize.dataset.bound) {
                  chooseSize.dataset.bound = 'true';
                  chooseSize.addEventListener('click', () => {
                    const sizePicker = productContent.querySelector('.product-variants-options');
                    (sizePicker || productContent).scrollIntoView({ behavior: 'smooth', block: 'center' });
                    window.setTimeout(() => {
                      const sizeControl = productContent.querySelector('.custom-select-button, input[name^="option"]');
                      if (sizeControl) sizeControl.focus({ preventScroll: true });
                    }, 450);
                  });
                }
              };

              const fsQueueProductEnhance = () => {
                if (fsProductEnhanceQueued) return;
                fsProductEnhanceQueued = true;
                window.requestAnimationFrame(fsEnhanceProduct);
              };

              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', fsEnhanceProduct, { once: true });
              } else {
                fsEnhanceProduct();
              }
              document.addEventListener('shopify:section:load', fsQueueProductEnhance);
              new MutationObserver(fsQueueProductEnhance).observe(document.documentElement, { childList: true, subtree: true });
            })();
          </script>
        {% endif %}
        <div class="custom-footer-group">  
        {% sections 'footer-group' %}
        </div>
        {% section 'mobile-dock' %}
      </div> 
        {% render 'newsletter-popup' %}
        {% render 'cookies-popup' %}
        {% render 'age-verification' %}
        {% render 'search-drawer' %}
        {% render 'cart-drawer' %}
        {% render 'quick-view' %}
        {% render 'scroll-top' %}

        {% if settings.enable_shipping and settings.shipping_rate != blank %}
          <div id="mini-cart-shipping"  data-minicart-shipping {% if settings.enable_shipping and settings.shipping_rate != blank %}  data-shipping-rate="{{ settings.shipping_rate | times: 100 }}" data-shippin-text="{{ settings.shipping_text }}"{% endif %}>
            <select id="shipping-countries" class="hidden" disabled>
              {{ country_option_tags }}
            </select>
          </div>
        {% endif %}
        {% if settings.enable_animation %}
          <script>
            document.addEventListener("DOMContentLoaded",function(){
              AOS.init({
                startEvent: 'DOMContentLoaded',
                offset: 160,
                once: true,
              });
              setTimeout(function () {
                if (AOS) {
                  AOS.refresh();
                }
              }, 1000);
            });
          </script>
        {% endif %}
      <script>
        document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
        if (Shopify.designMode) {
          document.documentElement.classList.add('shopify-design-mode');
        }
    
      </script>
     
