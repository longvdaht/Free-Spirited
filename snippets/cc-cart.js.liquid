{%- comment %}
  @param cart (cart, mandatory)
  @param checkout_url (string, mandatory) the checkout url
  @param checkout_button_selector (string) the query selector for the checkout button

  COUPON HANDLING — changed deliberately, read before editing.

  This snippet used to read the `discount_code` cookie and forward it to CC as
  couponCode. That is unsafe: Shopify's /discount/ endpoint sets that cookie even
  when it REJECTS the code, and CC does not re-validate customer eligibility. So
  a code Shopify refused (belongs to another customer) or one the theme hid
  (under its minimum on the Insider subtotal) was still charged at CC — the cart
  showed one price, the checkout charged another.

  The coupon now comes from window.fsCheckoutCoupon() in fs-discount.js, which
  returns a code ONLY if Shopify says it is applicable AND the theme verified it
  against the Insider subtotal. It fails closed: if it cannot verify, no coupon is
  sent. Do not reintroduce the cookie read as a fallback — that restores the hole.
{% endcomment -%}

{% unless checkout_url %}
  {% assign checkout_url = 'https://checkout.shopfreespirited.com/checkout' %}
{% endunless %}

{% unless checkout_button_selector %}
  {% assign checkout_button_selector = '[type="submit"][name="checkout2"]' %}
{% endunless %}
<script>
  document.addEventListener("DOMContentLoaded", function () {

    var debug = true ? console.log.bind(console, '[DEBUG][RedirectCart]') : function () {};

    debug('Script loaded');

    window.RedirectCart = function (options) {
      var self = {};

      function productIdsWithQuantities() {
        {%- assign added_first = false -%}
        return {
          {%- for item in cart.items -%}
            {%- if item.variant.metafields.productId.productId -%}
              {%- if added_first %},{% endif -%}
              {%- if item.selling_plan_allocation -%}
                "{{ item.variant.metafields.productId.productId}}{{"|"}}{{item.selling_plan_allocation.selling_plan.name}}": {{ item.quantity | json }}
              {%- else -%}
                "{{ item.variant.metafields.productId.productId }}": {{ item.quantity | json }}
              {% endif -%}
              {%- assign added_first = true -%}
            {%- endif -%}
          {%- endfor -%}
        };
      }

      function init() {
        self.options = Object.assign({
          checkoutButtonSelector: '{{ checkout_button_selector }}',
          checkoutUrl: '{{ checkout_url }}'
        }, options);

        self.$checkoutButton = $(self.options.checkoutButtonSelector);

        debug('Initialized with options', self.options);

        inject();
      }

      function inject() {
        debug('Inject');
        $(document).on('click', self.options.checkoutButtonSelector, checkout);
      }

      // Ask the theme which coupon (if any) CC is allowed to apply. Resolves to
      // null when fs-discount.js is absent, so a missing script means no coupon
      // rather than an unverified one.
      function verifiedCoupon() {
        if (typeof window.fsCheckoutCoupon !== 'function') {
          debug('fsCheckoutCoupon unavailable -> no coupon');
          return Promise.resolve(null);
        }
        return window.fsCheckoutCoupon().catch(function (e) {
          debug('coupon gate failed -> no coupon', e);
          return null;
        });
      }

      // Shopify's own checkout. Used whenever the Checkout Champ handoff cannot
      // be built: a completed Shopify order beats a dead button or a Checkout
      // Champ page with an empty cart, and it leaves a visible trail either way.
      function fallbackToShopifyCheckout(reason) {
        debug('Checkout Champ handoff unavailable, using Shopify checkout:', reason);
        window.location.href = '/checkout';
      }

      function checkout(event) {
        event.preventDefault();
        event.stopPropagation();

        Promise.all([
          fetch('/cart?view=meta-data.json').then(function (r) { return r.json(); }),
          verifiedCoupon()
        ]).then(function (results) {
          var data = results[0];
          var items = (data && data.meta_product_id_array) || [];

          // No line in the cart carries a Checkout Champ id, so `products=` would
          // go out empty and drop the shopper on a checkout with nothing in it —
          // no cart, no way back. A cart holding only the Insiders Club is that
          // cart today: the Club product has no productId metafield.
          if (!items.length) {
            fallbackToShopifyCheckout('no Checkout Champ product ids in the cart');
            return;
          }

          var checkoutUrl = getCheckoutURL(data, results[1]);
          debug('Checkout ->', checkoutUrl);
          window.location.href = checkoutUrl;
        }).catch(function (e) {
          // There was no catch here at all. A rejected fetch, or the invalid JSON
          // the meta-data template used to emit, was swallowed silently and the
          // checkout button simply did nothing when clicked.
          fallbackToShopifyCheckout(e);
        });
      }

      function getCartCookie(name) {
        var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
        if (match) {
          return match[2];
        }
        return null;
      }

      function getCheckoutURL(data, couponCode) {
        var cookie = getCartCookie('cart');
        // Was getCartCookie('?affId'). The '?' went straight into the RegExp,
        // where it made the leading `(^| )` optional instead of naming a cookie —
        // so the name matched as a SUFFIX of any other cookie ending in "affId".
        var affId = getCartCookie('affId');

        var urlLineItems = Object.keys(data.meta_product_id_array).reduce(function (output, productId) {
          return output.concat([ data.meta_product_id_array[productId].id + ':' + data.meta_product_id_array[productId].quantity ]);
        }, []).join(';');

        var checkoutUrl = self.options.checkoutUrl + '?products=' + urlLineItems + '&cartId=' + cookie;
        // Was `typeof affId !== 'undefined'`, which is ALWAYS true: getCartCookie
        // returns null when the cookie is absent, and `typeof null` is 'object'.
        // Every checkout URL therefore carried the literal string `affId=null`,
        // which Checkout Champ records as the affiliate id. Send it only when a
        // real value exists.
        if (affId) {
          checkoutUrl += '&affId=' + encodeURIComponent(affId);
        }
        // Verified codes only — see the comment at the top of this file.
        if (couponCode) {
          checkoutUrl += '&couponCode=' + encodeURIComponent(couponCode);
        }

        return checkoutUrl;
      }

      init();

      return self;
    };

    var instance = new RedirectCart();

  });
</script>
