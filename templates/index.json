    "custom_liquid_PcMnFE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_visibility": "always",
        "custom_liquid": "<style>\n  .fs-ugc-proof,\n  .fs-ugc-proof * {\n    box-sizing: border-box;\n  }\n\n  .fs-ugc-proof {\n    padding: 54px 20px 58px;\n    overflow: hidden;\n    color: #151515;\n    background: linear-gradient(180deg, #f7f8f2 0%, #ffffff 100%);\n  }\n\n  .fs-ugc-proof__inner {\n    max-width: 1120px;\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  .fs-ugc-proof__eyebrow {\n    margin: 0 0 9px;\n    color: #016f94;\n    font-size: 12px;\n    font-weight: 850;\n    line-height: 1.2;\n    letter-spacing: .095em;\n    text-transform: uppercase;\n  }\n\n  .fs-ugc-proof__title {\n    max-width: 760px;\n    margin: 0 auto 10px;\n    font-size: clamp(28px, 4vw, 48px);\n    line-height: 1.08;\n  }\n\n  .fs-ugc-proof__copy {\n    max-width: 690px;\n    margin: 0 auto 28px;\n    color: #484848;\n    font-size: 16px;\n    line-height: 1.55;\n  }\n\n  .fs-ugc-proof__carousel {\n    position: relative;\n    max-width: 930px;\n    margin: 0 auto;\n  }\n\n  .fs-ugc-proof__grid {\n    display: grid;\n    grid-template-columns: none;\n    grid-auto-flow: column;\n    grid-auto-columns: calc((100% - 18px) / 2);\n    margin: 0;\n    padding: 8px 4px 16px;\n    gap: 18px;\n    overflow-x: auto;\n    overscroll-behavior-inline: contain;\n    scroll-behavior: smooth;\n    scroll-snap-type: x mandatory;\n    scrollbar-width: none;\n  }\n\n  .fs-ugc-proof__grid::-webkit-scrollbar {\n    display: none;\n  }\n\n  .fs-ugc-proof__card {\n    display: block;\n    overflow: hidden;\n    background: #fff;\n    border: 1px solid rgba(1, 111, 148, .13);\n    border-radius: 16px;\n    box-shadow: 0 10px 28px rgba(17, 39, 48, .09);\n    scroll-snap-align: center;\n    transition: transform .2s ease, box-shadow .2s ease;\n  }\n\n  .fs-ugc-proof__card:hover {\n    transform: translateY(-3px);\n    box-shadow: 0 14px 32px rgba(17, 39, 48, .14);\n  }\n\n  .fs-ugc-proof__card img {\n    display: block;\n    width: 100%;\n    height: auto;\n    aspect-ratio: 4 / 5;\n    object-fit: cover;\n  }\n\n  .fs-ugc-proof__nav {\n    position: absolute;\n    top: 50%;\n    z-index: 2;\n    display: inline-flex;\n    width: 46px;\n    height: 46px;\n    padding: 0;\n    align-items: center;\n    justify-content: center;\n    color: #016f94;\n    background: rgba(255, 255, 255, .96);\n    border: 1px solid rgba(1, 111, 148, .22);\n    border-radius: 50%;\n    box-shadow: 0 8px 22px rgba(17, 39, 48, .18);\n    cursor: pointer;\n    transform: translateY(-50%);\n    transition: opacity .2s ease, transform .2s ease;\n  }\n\n  .fs-ugc-proof__nav:hover:not(:disabled) {\n    transform: translateY(-50%) scale(1.05);\n  }\n\n  .fs-ugc-proof__nav:focus-visible {\n    outline: 3px solid #adcc0c;\n    outline-offset: 3px;\n  }\n\n  .fs-ugc-proof__nav:disabled {\n    opacity: .32;\n    cursor: default;\n  }\n\n  .fs-ugc-proof__nav--prev {\n    left: -58px;\n  }\n\n  .fs-ugc-proof__nav--next {\n    right: -58px;\n  }\n\n  .fs-ugc-proof__note {\n    margin: 17px 0 0;\n    color: #666;\n    font-size: 12px;\n    line-height: 1.4;\n  }\n\n  .fs-ugc-proof__swipe {\n    margin: 0;\n    color: #666;\n    font-size: 11px;\n    line-height: 1.4;\n  }\n\n  .fs-ugc-proof__cta {\n    display: inline-flex;\n    min-height: 50px;\n    margin-top: 22px;\n    padding: 12px 28px;\n    align-items: center;\n    justify-content: center;\n    color: #fff;\n    background: #016f94;\n    border: 2px solid #adcc0c;\n    border-radius: 999px;\n    font-size: 15px;\n    font-weight: 850;\n    line-height: 1.2;\n    text-decoration: none;\n    transition: transform .2s ease, background .2s ease;\n  }\n\n  .fs-ugc-proof__cta:hover {\n    color: #fff;\n    background: #005d7c;\n    transform: translateY(-2px);\n  }\n\n  @media (max-width: 767px) {\n    .fs-ugc-proof {\n      padding: 38px 0 42px;\n    }\n\n    .fs-ugc-proof__inner {\n      padding: 0 18px;\n    }\n\n    .fs-ugc-proof__eyebrow {\n      font-size: 10px;\n    }\n\n    .fs-ugc-proof__title {\n      font-size: 30px;\n    }\n\n    .fs-ugc-proof__copy {\n      margin-bottom: 21px;\n      font-size: 14px;\n    }\n\n    .fs-ugc-proof__carousel {\n      max-width: none;\n      margin-right: -18px;\n    }\n\n    .fs-ugc-proof__grid {\n      grid-auto-columns: 86%;\n      padding: 6px 18px 14px 0;\n      gap: 12px;\n    }\n\n    .fs-ugc-proof__card {\n      border-radius: 13px;\n    }\n\n    .fs-ugc-proof__nav {\n      display: none;\n    }\n\n    .fs-ugc-proof__cta {\n      width: 100%;\n      margin-top: 18px;\n    }\n  }\n\n  @media (min-width: 768px) and (max-width: 1050px) {\n    .fs-ugc-proof__nav--prev {\n      left: 12px;\n    }\n\n    .fs-ugc-proof__nav--next {\n      right: 12px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .fs-ugc-proof__grid {\n      scroll-behavior: auto;\n    }\n\n    .fs-ugc-proof__card,\n    .fs-ugc-proof__cta,\n    .fs-ugc-proof__nav {\n      transition: none;\n    }\n  }\n</style>\n\n<section class=\"fs-ugc-proof\" aria-labelledby=\"fs-ugc-proof-title\">\n  <div class=\"fs-ugc-proof__inner\">\n    <p class=\"fs-ugc-proof__eyebrow\">Photos from our customers. Every day.</p>\n    <h2 class=\"fs-ugc-proof__title\" id=\"fs-ugc-proof-title\">Worn by real people. Made to be noticed.</h2>\n    <p class=\"fs-ugc-proof__copy\">Customers tell us it’s how they feel when they put it on—bold, bright, and unmistakably themselves. Every shirt is hand-dyed, pre-washed, and made to be lived in.</p>\n\n    <div class=\"fs-ugc-proof__carousel\">\n      <button class=\"fs-ugc-proof__nav fs-ugc-proof__nav--prev\" type=\"button\" aria-label=\"Show previous customer photos\" data-fs-ugc-prev disabled>←</button>\n      <div class=\"fs-ugc-proof__grid\" aria-label=\"Real Free Spirited customer photos\" data-fs-ugc-track>\n        <a class=\"fs-ugc-proof__card\" href=\"/collections/shop-sale\" aria-label=\"Shop customer-favorite tie-dye styles\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-1.jpg?v=1787857564&width=900\"\n          srcset=\"https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-1.jpg?v=1787857564&width=540 540w, https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-1.jpg?v=1787857564&width=900 900w, https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-1.jpg?v=1787857564&width=1080 1080w\"\n          sizes=\"(max-width: 767px) 82vw, 450px\"\n          width=\"1080\"\n          height=\"1350\"\n          loading=\"lazy\"\n          decoding=\"async\"\n          alt=\"Real Free Spirited customers wearing colorful hand-dyed tie-dye clothing\"\n        >\n        </a>\n\n        <a class=\"fs-ugc-proof__card\" href=\"/collections/shop-sale\" aria-label=\"Shop customer-favorite hand-dyed shirts\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-01.jpg?v=1787858490&width=900\"\n            srcset=\"https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-01.jpg?v=1787858490&width=540 540w, https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-01.jpg?v=1787858490&width=900 900w, https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-01.jpg?v=1787858490&width=1080 1080w\"\n            sizes=\"(max-width: 767px) 82vw, 450px\"\n            width=\"1080\"\n            height=\"1350\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            alt=\"Real Free Spirited customers wearing hand-dyed shirts in everyday life\"\n          >\n        </a>\n\n        <a class=\"fs-ugc-proof__card\" href=\"/collections/shop-sale\" aria-label=\"See colorful customer-favorite tie-dye styles\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-07.jpg?v=1787858494&width=900\"\n            srcset=\"https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-07.jpg?v=1787858494&width=540 540w, https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-07.jpg?v=1787858494&width=900 900w, https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-07.jpg?v=1787858494&width=1080 1080w\"\n            sizes=\"(max-width: 767px) 82vw, 450px\"\n            width=\"1080\"\n            height=\"1350\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            alt=\"Real Free Spirited customers and friends wearing colorful tie-dye clothing\"\n          >\n        </a>\n\n        <a class=\"fs-ugc-proof__card\" href=\"/collections/shop-sale\" aria-label=\"See more customer-favorite tie-dye styles\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-2.png?v=1787857568&width=900\"\n            srcset=\"https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-2.png?v=1787857568&width=540 540w, https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-2.png?v=1787857568&width=900 900w, https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-2.png?v=1787857568&width=1080 1080w\"\n            sizes=\"(max-width: 767px) 82vw, 450px\"\n            width=\"1080\"\n            height=\"1350\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            alt=\"More real Free Spirited customers wearing colorful hand-dyed tie-dye clothing\"\n          >\n        </a>\n\n        <a class=\"fs-ugc-proof__card\" href=\"/collections/shop-sale\" aria-label=\"Shop hand-dyed styles worn by our community\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-03.jpg?v=1787858502&width=900\"\n            srcset=\"https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-03.jpg?v=1787858502&width=540 540w, https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-03.jpg?v=1787858502&width=900 900w, https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-03.jpg?v=1787858502&width=1080 1080w\"\n            sizes=\"(max-width: 767px) 82vw, 450px\"\n            width=\"1080\"\n            height=\"1350\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            alt=\"A diverse group of real Free Spirited customers wearing hand-dyed shirts\"\n          >\n        </a>\n\n        <a class=\"fs-ugc-proof__card\" href=\"/collections/shop-sale\" aria-label=\"Shop colorful styles for friends and family\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-06.jpg?v=1787858498&width=900\"\n            srcset=\"https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-06.jpg?v=1787858498&width=540 540w, https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-06.jpg?v=1787858498&width=900 900w, https://cdn.shopify.com/s/files/1/0624/1917/3575/files/free-spirited-real-customers-community-06.jpg?v=1787858498&width=1080 1080w\"\n            sizes=\"(max-width: 767px) 82vw, 450px\"\n            width=\"1080\"\n            height=\"1350\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            alt=\"Free Spirited customers, friends and family wearing colorful tie-dye\"\n          >\n        </a>\n      </div>\n      <button class=\"fs-ugc-proof__nav fs-ugc-proof__nav--next\" type=\"button\" aria-label=\"Show more customer photos\" data-fs-ugc-next>→</button>\n    </div>\n\n    <p class=\"fs-ugc-proof__swipe\" aria-hidden=\"true\">Swipe or use the arrows to see more customer photos →</p>\n    <p class=\"fs-ugc-proof__note\">Real Free Spirited customers, shared with permission.</p>\n    <a class=\"fs-ugc-proof__cta\" href=\"/collections/shop-sale\">Shop Customer Favorites</a>\n  </div>\n</section>\n\n<script>\n  (() => {\n    const script = document.currentScript;\n    const section = script && script.previousElementSibling;\n    if (!section || !section.classList.contains('fs-ugc-proof')) return;\n\n    const track = section.querySelector('[data-fs-ugc-track]');\n    const previous = section.querySelector('[data-fs-ugc-prev]');\n    const next = section.querySelector('[data-fs-ugc-next]');\n    if (!track || !previous || !next) return;\n\n    const updateButtons = () => {\n      const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);\n      previous.disabled = track.scrollLeft <= 4;\n      next.disabled = track.scrollLeft >= maxScroll - 4;\n    };\n\n    const move = direction => {\n      const card = track.querySelector('.fs-ugc-proof__card');\n      const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;\n      const distance = card ? card.getBoundingClientRect().width + gap : track.clientWidth;\n      track.scrollBy({ left: direction * distance, behavior: 'smooth' });\n    };\n\n    previous.addEventListener('click', () => move(-1));\n    next.addEventListener('click', () => move(1));\n    track.addEventListener('scroll', () => requestAnimationFrame(updateButtons), { passive: true });\n    window.addEventListener('resize', updateButtons, { passive: true });\n    updateButtons();\n  })();\n</script>\n",
