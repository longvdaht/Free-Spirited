    "custom_liquid_PcMnFE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_visibility": "always",
        "custom_liquid": "<!-- \n  FREE SPIRITED - Homepage Community Section\n  \n  INSTRUCTIONS:\n  1. Go to Settings > Files in Shopify admin\n  2. Upload both testimonial images\n  3. Replace PASTE_FIRST_IMAGE_URL_HERE and PASTE_SECOND_IMAGE_URL_HERE with the Shopify CDN URLs\n  4. Copy this entire code block\n  5. Add a Custom Liquid section to your homepage in the theme editor\n  6. Paste it in, save, and preview\n-->\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=DM+Sans:wght@400;500;700&display=swap');\n\n  .fs-community {\n    padding: 60px 20px;\n    background: linear-gradient(180deg, #ffffff 0%, #f7f5f0 100%);\n    text-align: center;\n    font-family: 'DM Sans', sans-serif;\n  }\n\n  .fs-community-inner {\n    max-width: 1000px;\n    margin: 0 auto;\n  }\n\n  .fs-eyebrow {\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 3px;\n    text-transform: uppercase;\n    color: #d4a259;\n    margin-bottom: 12px;\n  }\n\n  .fs-headline {\n    font-family: 'Playfair Display', serif;\n    font-size: 38px;\n    font-weight: 700;\n    color: #1a1a1a;\n    line-height: 1.2;\n    margin: 0 0 8px 0;\n  }\n\n  .fs-headline em {\n    font-style: italic;\n    color: #006F94;\n  }\n\n  .fs-subhead {\n    font-size: 17px;\n    color: #666;\n    max-width: 600px;\n    margin: 0 auto 14px auto;\n    line-height: 1.6;\n  }\n\n  .fs-member-count {\n    display: inline-block;\n    background: #006F94;\n    color: #fff;\n    font-size: 14px;\n    font-weight: 700;\n    padding: 6px 18px;\n    border-radius: 50px;\n    margin-bottom: 35px;\n    letter-spacing: 0.5px;\n  }\n\n  .fs-reviews-grid {\n    display: flex;\n    gap: 20px;\n    justify-content: center;\n    flex-wrap: wrap;\n    margin-bottom: 35px;\n  }\n\n  .fs-reviews-grid img {\n    max-width: 47%;\n    min-width: 280px;\n    border-radius: 10px;\n    box-shadow: 0 4px 20px rgba(0,0,0,0.08);\n    transition: transform 0.2s ease;\n  }\n\n  .fs-reviews-grid img:hover {\n    transform: scale(1.02);\n  }\n\n  .fs-social-proof {\n    display: flex;\n    justify-content: center;\n    gap: 40px;\n    flex-wrap: wrap;\n    margin-bottom: 35px;\n    padding: 25px 0;\n    border-top: 1px solid #e5e0d8;\n    border-bottom: 1px solid #e5e0d8;\n  }\n\n  .fs-stat {\n    text-align: center;\n  }\n\n  .fs-stat-number {\n    font-family: 'Playfair Display', serif;\n    font-size: 32px;\n    font-weight: 700;\n    color: #006F94;\n    display: block;\n  }\n\n  .fs-stat-label {\n    font-size: 13px;\n    color: #888;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    margin-top: 4px;\n  }\n\n  .fs-cta-wrap {\n    margin-top: 10px;\n  }\n\n  .fs-cta-text {\n    font-family: 'Playfair Display', serif;\n    font-style: italic;\n    font-size: 20px;\n    color: #444;\n    margin-bottom: 18px;\n  }\n\n  .fs-cta-btn {\n    display: inline-block;\n    background: #006F94;\n    color: #fff;\n    font-family: 'DM Sans', sans-serif;\n    font-size: 16px;\n    font-weight: 700;\n    text-decoration: none;\n    padding: 14px 40px;\n    border-radius: 50px;\n    letter-spacing: 0.5px;\n    transition: background 0.2s ease, transform 0.2s ease;\n  }\n\n  .fs-cta-btn:hover {\n    background: #005a78;\n    transform: translateY(-2px);\n    color: #fff;\n    text-decoration: none;\n  }\n\n  @media (max-width: 600px) {\n    .fs-community {\n      padding: 40px 15px;\n    }\n    .fs-headline {\n      font-size: 28px;\n    }\n    .fs-subhead {\n      font-size: 15px;\n    }\n    .fs-reviews-grid img {\n      max-width: 100%;\n      min-width: unset;\n    }\n    .fs-social-proof {\n      gap: 25px;\n    }\n    .fs-stat-number {\n      font-size: 26px;\n    }\n  }\n</style>\n\n<div class=\"fs-community\">\n  <div class=\"fs-community-inner\">\n\n    <div class=\"fs-eyebrow\">Join the Movement</div>\n    <h2 class=\"fs-headline\">Thousands of Women Already <em>Love</em> Their Shirts</h2>\n    <p class=\"fs-subhead\">Real reviews from real members. No filters, no fuss. Just women who found their favorite tee and never looked back.</p>\n    <div class=\"fs-member-count\">&#10026; Thousands of Happy Members & Growing</div>\n\n    <div class=\"fs-reviews-grid\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0624/1917/3575/files/Comments_1.png?v=1775488694\" alt=\"Real Facebook reviews from Free Spirited customers\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0624/1917/3575/files/Comments_2.png?v=1775488696\" alt=\"More real customer reviews from Free Spirited members\">\n    </div>\n\n    <div class=\"fs-social-proof\">\n      <div class=\"fs-stat\">\n        <span class=\"fs-stat-number\">4.8 &#9733;</span>\n        <span class=\"fs-stat-label\">Average Rating</span>\n      </div>\n      <div class=\"fs-stat\">\n        <span class=\"fs-stat-number\">5,000+</span>\n        <span class=\"fs-stat-label\">Happy Members</span>\n      </div>\n      <div class=\"fs-stat\">\n        <span class=\"fs-stat-number\">Handmade</span>\n        <span class=\"fs-stat-label\">Every Single Shirt</span>\n      </div>\n    </div>\n\n    <div class=\"fs-cta-wrap\">\n      <div class=\"fs-cta-text\">See what all the fuss is about.</div>\n      <a href=\"/collections/shop-sale\" class=\"fs-cta-btn\">Shop Now & Join the Family</a>\n    </div>\n\n  </div>\n</div>\n<parameter name=\"file_text\">",
