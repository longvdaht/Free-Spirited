    "collapsible_content_WLFhP6": {
      "type": "collapsible-content",
      "blocks": {
        "content_DeJHiW": {
          "type": "content",
          "settings": {
            "heading": "What makes Free Spirited’s tie-dye apparel unique?",
            "content": "<p>Our tie-dye pieces are handcrafted, meaning no two items are exactly alike. We use high-quality, 100% pre-shrunk cotton, ensuring that our vibrant colors stay bright and beautiful even after many washes.</p>"
          }
        },
        "content_g6G89R": {
          "type": "content",
          "settings": {
            "heading": "What are the benefits of the Free Spirited Insiders Club?",
            "content": "<p>Club members receive a $30 monthly credit, our lowest Insider Pricing, early access to new drops, special offers, priority support, and a free U.S. shipping code in the member portal for future eligible orders.</p>"
          }
        },
        "content_8wVekt": {
          "type": "content",
          "settings": {
            "heading": "How do I join the Free Spirited Insiders Club?",
            "content": "<p>Choose Insider Pricing in the cart or <a href=\"/products/free-spirited-insiders\" title=\"Free Spirited Insiders Club\"><strong>join the Club directly</strong></a>. Insider Pricing includes a 21-day Club trial; after that, recurring Club membership is $24.95/month plus applicable taxes unless canceled.</p>"
          }
        },
        "content_FHkFKA": {
          "type": "content",
          "settings": {
            "heading": "What sizes do you offer?",
            "content": "<p>We offer a wide range of sizes from <strong>S to 5XL</strong>, making our clothing accessible to everyone. We believe in inclusivity, so no matter your size, you can find the perfect fit at Free Spirited.</p>"
          }
        },
        "content_BmjRic": {
          "type": "content",
          "settings": {
            "heading": "How much does shipping cost?",
            "content": "<p>We offer free U.S. shipping on orders over $50. For orders under $50, shipping fees are $4.95. After joining, retrieve your free U.S. shipping code from the member portal for future eligible orders.</p>"
          }
        },
        "content_3rekQA": {
          "type": "content",
          "settings": {
            "heading": "Can I return or exchange an item?",
            "content": "<p>Yes! We offer a hassle-free <strong>30-day return or exchange policy</strong>. If you're not satisfied with your purchase, simply contact our customer support team, and we'll guide you through the process.</p>"
          }
        },
        "content_UJC66F": {
          "type": "content",
          "settings": {
            "heading": "Are you closing your entire store?",
            "content": "<p><strong>No, we’re not closing our store!</strong> We run collection closing sales to make room for new designs. Some of our current styles will be <strong>retired</strong>, while others may return in our upcoming collections.</p><p>If you see a design you love, we recommend grabbing it before it’s gone—prices and availability may change in future collections!</p>"
          }
        },
        "content_wLzhNq": {
          "type": "content",
          "settings": {
            "heading": "Can I shop at Full Price without joining the Club?",
            "content": "<p>Yes. Every product can be purchased two ways. Insider Pricing is selected by default and includes the Free Spirited Insiders Club trial. Or select Full Price in the cart drawer for a standard one-time purchase with no Club membership.</p>"
          }
        },
        "content_hUnJgU": {
          "type": "content",
          "settings": {
            "heading": "How do I care for my tie-dye apparel?",
            "content": "<p>For best results, machine wash your tie-dye garments in <strong>cold water</strong> with similar colors and <strong>tumble dry on low</strong>. This will help preserve the vibrant colors and ensure the longevity of your clothing.</p>"
          }
        },
        "content_z9dWYL": {
          "type": "content",
          "settings": {
            "heading": "Are your products sustainable?",
            "content": "<p>Yes, we are committed to sustainable practices. Our apparel is crafted with eco-friendly materials, and we aim to minimize our environmental impact through ethical production methods.</p>"
          }
        },
        "content_R8f4Tx": {
          "type": "content",
          "settings": {
            "heading": "How can I see all of your reviews?",
            "content": "<p>You can check out all of our customer reviews on <a href=\"https://www.reviews.io/company-reviews/store/shopfreespirited.com\" title=\"https://www.reviews.io/company-reviews/store/shopfreespirited.com\"><strong>Reviews.io</strong></a>. We’re proud to have so many happy customers who love our super-soft, vibrant tie-dye shirts! 💜</p>"
          }
        },
        "content_C4CDfi": {
          "type": "content",
          "settings": {
            "heading": "Do you ship internationally?",
            "content": "<p>Yes, we ship to every country!</p>"
          }
        },
        "content_gDe66p": {
          "type": "content",
          "settings": {
            "heading": "How can I track my order?",
            "content": "<p>Once your order is shipped, you'll receive a tracking number via email. You can use this number to track your package directly from our website or through the carrier’s site.</p>"
          }
        }
      },
