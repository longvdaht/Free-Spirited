    "multicolumn_KzrxVe": {
      "type": "multicolumn",
      "blocks": {
        "column_R3e9Hn": {
          "type": "column",
          "settings": {
            "heading": "<strong>Handcrafted with Love</strong>",
            "description": "Each Free Spirited piece is hand-dyed, ensuring that no two items are exactly alike. From bright, bold hues to soft, pastel shades, our tie-dye creations are a reflection of the artistry and care we pour into every garment. We use 100% pre-shrunk cotton to ensure your clothes are not only beautiful but also soft, comfortable, and built to last.\n\nBecause our products are handcrafted, you’re not just buying a shirt or dress—you’re investing in wearable art that’s as unique as you are.",
            "link_label": "",
            "link_url": "",
            "column_background": true,
            "column_background_color": "#f2f2f2",
            "column_text_color": "#000000",
            "column_link_color": "#2877ff"
          }
        },
        "column_m6cBbC": {
          "type": "column",
          "settings": {
            "heading": "<strong> Quality and Affordability</strong>",
            "description": "At Free Spirited, we believe that everyone deserves to feel good in what they wear. That’s why we are committed to offering high-quality, affordable apparel. Our tie-dye shirts, starting at just $11.95, prove that quality doesn’t have to come with a high price tag. Whether you’re wearing our pieces to lounge at home or to make a statement while out and about, you can count on comfort, durability, and vibrant colors that stand the test of time.",
            "link_label": "",
            "link_url": "",
            "column_background": true,
            "column_background_color": "#f2f2f2",
            "column_text_color": "#000000",
            "column_link_color": "#2877ff"
          }
        },
        "column_iQx8fH": {
          "type": "column",
          "settings": {
            "heading": "<strong>Inclusive & Free Spirited at Our Core</strong>",
            "description": "Free Spirited is a brand that champions inclusivity. We know that style has no size limit, and that’s why we offer a wide range of sizes—from S to 5XL—so everyone can find the perfect fit. Our goal is to make every customer feel welcome and celebrated, no matter their shape, size, or style preference. You deserve to feel beautiful and confident, and we’re here to make that happen.",
            "link_label": "",
            "link_url": "",
            "column_background": true,
            "column_background_color": "#f2f2f2",
            "column_text_color": "#000000",
            "column_link_color": "#2877ff"
          }
        },
        "column_jPHLEM": {
          "type": "column",
          "settings": {
            "heading": "<strong>Building a Community of Free Spirits</strong>",
            "description": "Free Spirited isn’t just about selling clothes—it’s about creating a community of like-minded individuals who value creativity, authenticity, and self-expression. Our customers are more than just shoppers; they’re part of the Free Spirited family.\n\nThrough our Insiders membership program, we offer even more ways to connect with our brand and each other. Members get exclusive access to limited-edition designs, early releases, loyalty rewards, and even the chance to vote on future collections. We believe in building relationships, not just transactions, and our community is at the heart of everything we do.",
            "link_label": "",
            "link_url": "",
            "column_background": true,
            "column_background_color": "#f2f2f2",
            "column_text_color": "#000000",
            "column_link_color": "#2877ff"
          }
        },
        "column_7jQ7q9": {
          "type": "column",
          "settings": {
            "heading": "<strong>Sustainability and Social Responsibility</strong>",
            "description": "As a brand that celebrates freedom and joy, we also feel a deep responsibility to care for the world we live in. That’s why we’re committed to sustainable practices in our production process. We prioritize eco-friendly materials and ethical manufacturing to minimize our environmental impact. Free Spirited is proud to support hurricane relief efforts and other charitable causes that align with our values, giving back to the communities that support us.\n\nWe’re always looking for ways to improve and do better for the planet, and we invite our customers to join us in this mission.",
            "link_label": "",
            "link_url": "",
            "column_background": true,
            "column_background_color": "#f2f2f2",
            "column_text_color": "#000000",
            "column_link_color": "#2877ff"
          }
        },
        "column_KPHk6C": {
          "type": "column",
          "settings": {
            "heading": "<strong>Our Promise to You</strong>",
            "description": "At Free Spirited, we are passionate about creating products that bring joy, comfort, and individuality to your life. Whether you’re a long-time fan or a first-time shopper, we promise to deliver exceptional customer service, fast U.S. shipping, and a hassle-free shopping experience. Your satisfaction is our priority, and we’re always here to help if you need anything.\n\nWhen you wear Free Spirited, you’re not just wearing a piece of clothing—you’re wearing something that represents freedom, creativity, and a love for life. Thank you for being part of our journey!",
            "link_label": "",
            "link_url": "",
            "column_background": true,
            "column_background_color": "#f2f2f2",
            "column_text_color": "#000000",
            "column_link_color": "#2877ff"
          }
        }
      },
