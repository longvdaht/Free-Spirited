      "blocks": {
        "collapsible_tab_XxxDNp": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Exclusive Perks Just for You",
            "content": "<ul><li>When you join the Free Spirited Insiders Club, you unlock monthly credits, Insider Pricing, early access, rewards, and a community built around individuality, creativity, and joy.</li></ul>"
          }
        },
        "collapsible_tab_ptJih3": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "No Risk, All Reward",
            "content": "<ul><li>Enjoy the Club benefits without a long-term commitment. You can manage or cancel your recurring Club membership at any time.</li></ul>"
          }
        },
        "collapsible_tab_7z4MMj": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Be a Part of Something Special",
            "content": "<ul><li>Free Spirited is about more than just tie-dye. As an Insider, you’ll help shape future collections and contribute to the creative spirit that defines our brand.</li></ul>"
