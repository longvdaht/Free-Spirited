        "custom_liquid_BXqWDW": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% assign fs_one_of_kind_url = 'free-spirited-one-of-a-kind.svg' | file_url %}\n{% assign fs_money_back_url = 'free-spirited-money-back-guarantee.svg' | file_url %}\n{% assign fs_returns_url = 'free-spirited-free-returns.svg' | file_url %}\n\n<style>\n  .fs-trust,\n  .fs-trust * {\n    box-sizing: border-box;\n  }\n\n  .fs-trust {\n    --fs-teal: #016f94;\n    --fs-lime: #adcc0c;\n    --fs-ink: #151515;\n    max-width: 620px;\n    margin: 18px auto 26px;\n    padding: 0 6px;\n    font-family: inherit;\n  }\n\n  .fs-trust__grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 8px;\n  }\n\n  .fs-trust__item {\n    display: flex;\n    min-width: 0;\n    min-height: 132px;\n    padding: 12px 6px 13px;\n    flex-direction: column;\n    align-items: center;\n    justify-content: flex-start;\n    text-align: center;\n    background: #ffffff;\n    border: 1px solid rgba(1, 111, 148, 0.16);\n    border-radius: 14px;\n    box-shadow: 0 3px 10px rgba(17, 39, 48, 0.04);\n  }\n\n  .fs-trust__item--promise {\n    background: linear-gradient(\n      145deg,\n      rgba(173, 204, 12, 0.13),\n      rgba(1, 111, 148, 0.055)\n    );\n    border-color: rgba(139, 166, 0, 0.52);\n    box-shadow: 0 6px 16px rgba(1, 111, 148, 0.10);\n    transform: translateY(-2px);\n  }\n\n  .fs-trust__icon {\n    display: grid;\n    width: 60px;\n    height: 60px;\n    margin: 0 auto 8px;\n    place-items: center;\n  }\n\n  .fs-trust__icon img {\n    display: block;\n    width: 56px;\n    height: 56px;\n    object-fit: contain;\n  }\n\n  .fs-trust__item--promise .fs-trust__icon img {\n    width: 59px;\n    height: 59px;\n  }\n\n  .fs-trust__eyebrow {\n    margin-bottom: 3px;\n    color: var(--fs-teal);\n    font-size: 9px;\n    font-weight: 800;\n    line-height: 1.15;\n    letter-spacing: 0.045em;\n    text-transform: uppercase;\n  }\n\n  .fs-trust__item--promise .fs-trust__eyebrow {\n    color: #718500;\n  }\n\n  .fs-trust__title {\n    color: var(--fs-ink);\n    font-size: 13.5px;\n    font-weight: 800;\n    line-height: 1.23;\n  }\n\n  .fs-trust__proof {\n    display: flex;\n    margin-top: 10px;\n    padding: 11px 13px;\n    align-items: center;\n    gap: 9px;\n    color: var(--fs-ink);\n    background: #eff5dd;\n    border: 1px solid rgba(126, 150, 0, 0.12);\n    border-radius: 10px;\n    font-size: 12.5px;\n    line-height: 1.35;\n  }\n\n  .fs-trust__proof-check {\n    display: grid;\n    width: 20px;\n    height: 20px;\n    flex: 0 0 20px;\n    place-items: center;\n    color: #ffffff;\n    background: var(--fs-teal);\n    border-radius: 50%;\n    font-size: 11px;\n    font-weight: 900;\n    line-height: 1;\n  }\n\n  @media (max-width: 420px) {\n    .fs-trust {\n      margin-top: 16px;\n      padding: 0 2px;\n    }\n\n    .fs-trust__grid {\n      gap: 5px;\n    }\n\n    .fs-trust__item {\n      min-height: 122px;\n      padding: 10px 3px 11px;\n      border-radius: 12px;\n    }\n\n    .fs-trust__icon {\n      width: 52px;\n      height: 52px;\n      margin-bottom: 7px;\n    }\n\n    .fs-trust__icon img {\n      width: 49px;\n      height: 49px;\n    }\n\n    .fs-trust__item--promise .fs-trust__icon img {\n      width: 52px;\n      height: 52px;\n    }\n\n    .fs-trust__eyebrow {\n      font-size: 8.1px;\n      letter-spacing: 0.025em;\n    }\n\n    .fs-trust__title {\n      font-size: 12.25px;\n    }\n\n    .fs-trust__proof {\n      padding: 10px 11px;\n      font-size: 12px;\n    }\n  }\n</style>\n\n<section class=\"fs-trust\" aria-label=\"Why shop Free Spirited\">\n\n  <div class=\"fs-trust__grid\">\n\n    <div class=\"fs-trust__item\">\n      <div class=\"fs-trust__icon\" aria-hidden=\"true\">\n        <img\n          src=\"{{ fs_one_of_kind_url }}\"\n          alt=\"\"\n          width=\"512\"\n          height=\"512\"\n          decoding=\"async\"\n        >\n      </div>\n\n      <div class=\"fs-trust__eyebrow\">\n        Hand-Dyed\n      </div>\n\n      <div class=\"fs-trust__title\">\n        Always One<br>\n        of a Kind\n      </div>\n    </div>\n\n    <div class=\"fs-trust__item fs-trust__item--promise\">\n      <div class=\"fs-trust__icon\" aria-hidden=\"true\">\n        <img\n          src=\"{{ fs_money_back_url }}\"\n          alt=\"\"\n          width=\"512\"\n          height=\"512\"\n          decoding=\"async\"\n        >\n      </div>\n\n      <div class=\"fs-trust__eyebrow\">\n        Free Spirited Promise\n      </div>\n\n      <div class=\"fs-trust__title\">\n        Love It or<br>\n        Your Money Back\n      </div>\n    </div>\n\n    <div class=\"fs-trust__item\">\n      <div class=\"fs-trust__icon\" aria-hidden=\"true\">\n        <img\n          src=\"{{ fs_returns_url }}\"\n          alt=\"\"\n          width=\"512\"\n          height=\"512\"\n          decoding=\"async\"\n        >\n      </div>\n\n      <div class=\"fs-trust__eyebrow\">\n        No-Stress Shopping\n      </div>\n\n      <div class=\"fs-trust__title\">\n        Free &amp; Easy<br>\n        Returns\n      </div>\n    </div>\n\n  </div>\n\n  <div class=\"fs-trust__proof\">\n    <span class=\"fs-trust__proof-check\" aria-hidden=\"true\">\n      ✓\n    </span>\n\n    <span>\n      <strong>Shop with confidence.</strong>\n      Fewer than 1 in 100 customers use our money-back guarantee.\n    </span>\n  </div>"
          }
